files  = list.files("Data package")
files
files = c("COMPASS_SynopticCB_Manual Redox_2022.csv", "COMPASS_SynopticCB_Manual Redox_2023.csv", "COMPASS_SynopticCB_Manual Redox_2024.csv", "COMPASS_SynopticCB_Manual Redox_2025.csv", "dd.csv")
