#Create a text file that has the description of the data - This ideally should match the text that is in the data READ.ME
datadescription <- "These data are measurements of shallow porewater samples collected in 2022 and 2023 from the COMPASS 'synoptic' site in the Chesapeake Bay region: Goodwin Islands (GWI) and Moneystump (MSM). These sites have space for time transects spanning coastal upland forest (UP), coastal upland forest transitioning to wetland (TR), and wetland (WC) plots. In the UP and TR transect locations, rhizon (Rhizosphere Research Products) porewater samplers (n=3) were installed around Loblolly Pine (Pinus taeda) trees (n=8) one meter from the tree stem in a triangle formation. In the WC, replicate rhizons (n=8) were installed in a line next to other synoptic sampling infrastructure as there are no trees present in the WC. Rhizons were sampled monthly from roughly May-November in 2022 and 2023. A need was connected to the rhizon and then inserted into an evacuated exetainer to pull sample from the ground, the samplers were porous from 5-15cm deep. After collection in the exetainers, the three replicate samples from one tree were combined and aliquoted into vials to measure porewater ion, sulfide, iron, and nutrient concentrations. Only samples from the GWI TR were able to be collected, the other plot shallow soils were too dry or well drained."
#write to a text file
writeLines(datadescription, "Data package/SynopticCB_Redox_ESSDIVE_DataDescription.txt")
#Pull in the common synoptic authors list:
authors_common <- read.csv(here("Metadata/Synoptic CB/", "COMPASS_SynopticCB_common_essdive_author_list.csv"))
#create a list of the last names you want to pull
names_we_want <- c("Wilson", "Fien", "Phillips", "Read", "Stearns", "Bailey", "Megonigal")
#Subset the common list for the names that we want
author_list <- authors_common %>%
filter(last_name %in% names_we_want)
#if you need to add any other authors
others <- data.frame(
first_name = c("first_name1", "first_name2"),
last_name = c("last_name1", "last_name2"),
orcid = c("orcid_id1", "orcid_id2"),
affiliation = c("affiliation1", "affiliation2"),
email = c("email1", "email2")
)
#add in the other authors
#author_list <- bind_rows(author_list, others)
#write out the author list associated with the data:
write.csv(author_list, "Data package/author_list.csv", row.names = FALSE)
# Save as a PNG
ggsave(
filename = "COMPASS_SynopticCB_Rhizon_Tree_Summary.png",
plot = readme_fig_4,
width = 3,
height = 4,
dpi = 300,
bg = "white"
)
