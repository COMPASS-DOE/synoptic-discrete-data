library(dplyr)
library(ggplot2)
library(ggpubr)
library(stringr)
library(readxl)
library(tidyr)
library(tibble)
files <- list.files(path = "Processed Data", pattern = "\\.csv$", full.names = TRUE)
# 3. Read and combine all CSVs
all_data <- files %>%
lapply(function(file) {
df <- read.csv(file)
if ("Run_Date" %in% names(df)) {
df$Run_Date <- as.character(df$Run_Date)
}
return(df)
}) %>%
bind_rows()
all_data <- all_data[ ,-1]
##Fix run dates
all_data <- all_data %>%
mutate(Run_Date = ifelse(str_detect(Run_Date, "/"), format(as.Date(Run_Date, format = "%m/%d/%Y"), "%Y%m%d"), Run_Date)) %>%
mutate(Run_Date = gsub("\\.", "0", Run_Date))
##Fix SWH Sample Zones for 2023
##UPCON -> UP, UP -> SWAMP
unique(all_data$Zone)
all_data <- all_data %>%
rename(Zone_old = Zone) %>%
mutate(Zone = ifelse(Site == "SWH" & Zone_old == "UP", "SWAMP", Zone_old)) %>%
mutate(Zone = ifelse(Site == "SWH" & Zone_old == "UPCON", "UP", Zone))
all_data <- all_data %>%
select(-Zone_old)
##Calculate mean of CO2 data for each Site
SWH_mean_CO2 = mean(subset(all_data, Site == "SWH")$CO2_Conc_ppm_dilcorr, na.rm = TRUE)
MSM_mean_CO2 = mean(subset(all_data, Site == "MSM")$CO2_Conc_ppm_dilcorr, na.rm = TRUE)
GCW_mean_CO2 = mean(subset(all_data, Site == "GCW")$CO2_Conc_ppm_dilcorr, na.rm = TRUE)
GWI_mean_CO2 = mean(subset(all_data, Site == "GWI")$CO2_Conc_ppm_dilcorr, na.rm = TRUE)
##Flag data that is more than 100x the mean
all_data <- all_data %>%
mutate(qaqc_flag = NA) %>%
mutate(qaqc_flag = case_when(
is.na(qaqc_flag) & Site == "SWH" & CO2_Conc_ppm_dilcorr >= 10*SWH_mean_CO2 ~ "CO2 unusually high, not real value",
is.na(qaqc_flag) & Site == "MSM" & CO2_Conc_ppm_dilcorr >= 10*MSM_mean_CO2 ~ "CO2 unusually high, not real value",
is.na(qaqc_flag) & Site == "GCW" & CO2_Conc_ppm_dilcorr >= 10*GCW_mean_CO2 ~ "CO2 unusually high, not real value",
is.na(qaqc_flag) & Site == "GWI" & CO2_Conc_ppm_dilcorr >= 10*GWI_mean_CO2 ~ "CO2 unusually high, not real value",
TRUE ~ qaqc_flag    # NA if no match
))
##Calculate mean of CH4 data for each Site
SWH_mean_CH4 = mean(subset(all_data, Site == "SWH")$CH4_Conc_ppm_dilcorr, na.rm = TRUE)
MSM_mean_CH4 = mean(subset(all_data, Site == "MSM")$CH4_Conc_ppm_dilcorr, na.rm = TRUE)
GCW_mean_CH4 = mean(subset(all_data, Site == "GCW")$CH4_Conc_ppm_dilcorr, na.rm = TRUE)
GWI_mean_CH4 = mean(subset(all_data, Site == "GWI")$CH4_Conc_ppm_dilcorr, na.rm = TRUE)
##Flag data that is more than 100x the mean
all_data <- all_data %>%
mutate(qaqc_flag = case_when(
is.na(qaqc_flag) & Site == "SWH" & CH4_Conc_ppm_dilcorr >= 10*SWH_mean_CH4 ~ "CH4 unusually high, not real value",
is.na(qaqc_flag) & Site == "MSM" & CH4_Conc_ppm_dilcorr >= 10*MSM_mean_CH4 ~ "CH4 unusually high, not real value",
is.na(qaqc_flag) & Site == "GCW" & CH4_Conc_ppm_dilcorr >= 10*GCW_mean_CH4 ~ "CH4 unusually high, not real value",
is.na(qaqc_flag) & Site == "GWI" & CH4_Conc_ppm_dilcorr >= 10*GWI_mean_CH4 ~ "CH4 unusually high, not real value",
TRUE ~ qaqc_flag    # NA if no match
))
View(all_data)
#Put them in order and grab what we need
final_gcw_up <- gcw_up1 %>%
select( -c(Sample_Plot, Sample_Grid, Sample_ID))
#combine the TMP data with the rest of the data:
all_data_gcw <- rbind(all_data, final_gcw_up)
#combine the TMP data with the rest of the data:
all_data_gcw <- bind_rows(all_data, final_gcw_up)
#Put them in order and grab what we need
