##Pull in metadata dates
metadata_2022 <- read.csv("COMPASS_SynopticCB_PW_SampleLog_2022.csv")
metadata_2023 <- read.csv("COMPASS_SynopticCB_PW_SampleLog_2023.csv")
metadat <- bind_rows(metadata_2022, metadata_2023)
metadat <- metadat %>%
select("Year", "Month", "Day", "Site", "Transect.Location") %>%
rename(Zone = Transect.Location) %>%
mutate(Zone = case_when(
`Zone` == "Upland" ~ "UP",
`Zone` == "Transition" ~ "TR",
`Zone` == "Wetland" ~ "WC",
`Zone` == "UPCON" ~ "UPCON",
`Zone` == "Surface Water" ~ "SW",
TRUE                 ~ `Zone`    # keep original value if no match
)) %>%
mutate(
Zone = case_when(
Site == "SWH" & Zone == "UP" & Year == 2023 ~ "SWAMP",
Site == "SWH" & Zone == "UPCON" & Year == 2023 ~ "UP",
TRUE ~ `Zone`
))
metadat <- unique(metadat)
final_data2 <- final_data1 %>%
left_join(metadat, by = c("Year", "Month", "Site", "Zone"))
##Round data to sensitivity of the instrument
colnames(final_data2)
##Based on raw data from the instrument:
##SO4/Cl/Salinity - 4 decimals
##H2S/Fe - 3 decimals
##Nutrients - 6 decimals
##DIC - 2 decimals
final_data3 <- final_data2 %>%
mutate(SO4_ppm = round(as.numeric(SO4_ppm), digits = 4),
SO4_mM = round(as.numeric(SO4_mM), digits = 4),
Cl_ppm = round(as.numeric(Cl_ppm), digits = 4),
Cl_mM = round(as.numeric(Cl_mM), digits = 4),
salinity = round(as.numeric(salinity), digits = 4),
H2S_mean_uM = round(as.numeric(H2S_mean_uM), digits = 3),
H2S_sd_uM = round(as.numeric(H2S_sd_uM), digits = 3),
NH3_mgL = round(as.numeric(NH3_mgL), digits = 6),
NH3_uM = round(as.numeric(NH3_uM), digits = 6),
PO4_mgL = round(as.numeric(PO4_mgL), digits = 6),
PO4_uM = round(as.numeric(PO4_uM), digits = 6),
NOx_mgL = round(as.numeric(NOx_mgL), digits = 6),
NOx_uM = round(as.numeric(NOx_uM), digits = 6),
FE_2_mean_uM = round(as.numeric(FE_2_mean_uM), digits = 3),
FE_2_sd_uM = round(as.numeric(FE_2_sd_uM), digits = 3),
FE_3_mean_uM = round(as.numeric(FE_3_mean_uM), digits = 3),
FE_3_sd_uM = round(as.numeric(FE_3_sd_uM), digits = 3))
final_data4 <- final_data3 %>%
mutate(Sampler_Type = "Rhizon Sampler") %>%
rename(Replicate = Rep_Number,
Plot = Zone,
Cl_flag = Cl_Conc_flag,
SO4_flag = SO4_Conc_flag,
H2S_flag = H2S_Conc_flag,
NH3_flag = NH3_range,
PO4_flag = PO4_range,
NOx_flag = NOx_range,
FE_2_flag = FE_2_flag,
FE_3_flag = FE_3_flag,
Salinity = salinity) %>%
select(c("Project", "Region", "Year", "Month", "Day", "Site", "Plot", "Sample_ID", "Sampler_Type", "Replicate", "SO4_ppm", "SO4_mM", "SO4_flag", "Cl_ppm", "Cl_mM", "Cl_flag", "Salinity", "H2S_mean_uM", "H2S_sd_uM", "H2S_flag", "NH3_mgL", "NH3_uM", "NH3_flag", "PO4_mgL", "PO4_uM", "PO4_flag", "NOx_mgL", "NOx_uM", "NOx_flag", "FE_2_mean_uM", "FE_2_sd_uM", "FE_2_flag", "FE_3_mean_uM", "FE_3_sd_uM", "FE_3_flag"))
# For the concentration flags - let's remove when it says "within range" and just make those NA so there is only a flag if it is above or below detection.
unique(final_data4$FE_2_flag)
final_data5 <- final_data4 %>%
mutate(H2S_flag = gsub("Within Range", "", H2S_flag),
NH3_flag = gsub("Within_Range", "", NH3_flag),
PO4_flag = gsub("Within_Range", "", PO4_flag),
NOx_flag = gsub("Within_Range", "", NOx_flag),
FE_2_flag = gsub("within range", "", FE_2_flag),
FE_3_flag = gsub("within range", "", FE_3_flag),
SO4_flag = replace_na(SO4_flag, ""),
Cl_flag = replace_na(Cl_flag, ""),
H2S_flag = replace_na(H2S_flag, ""),
NH3_flag = replace_na(NH3_flag, ""),
PO4_flag = replace_na(PO4_flag, ""),
NOx_flag = replace_na(NOx_flag, ""),
FE_2_flag = replace_na(FE_2_flag, ""),
FE_3_flag = replace_na(FE_3_flag, ""))
##Export final data
write.csv(final_data5, "COMPASS_SynopticCB_Rhizon_Data.csv", row.names = FALSE)
head(final_data5)
compass_coolors2 <- c("black", "#726E75", "#F2AF29", "#5A9D43", "darkblue")
compass_coolors2 <- c("black", "#726E75", "#F2AF29", "#5A9D43", "darkblue")
so4_plot <- ggplot(data = final_data5, aes(Month, SO4_mM, color = Plot)) +
geom_point(size=3.5) +
#geom_line() +
facet_wrap(~Site) +
#scale_shape_manual(values=c(15,16,17,18))+
scale_color_manual(values=compass_coolors2)+
labs(x = "Month", y = "Sulfate (mM)", color = "") +
theme_classic()
so4_plot
View(final_data5)
#Create a text file that has the description of the data - This ideally should match the text that is in the data READ.ME
datadescription <- "These data are measurements of shallow porewater samples collected in 2022 and 2023 from the COMPASS 'synoptic' site in the Chesapeake Bay region: Goodwin Islands (GWI) and Moneystump (MSM). These sites have space for time transects spanning coastal upland forest (UP), coastal upland forest transitioning to wetland (TR), and wetland (WC) plots. In the UP and TR transect locations, rhizon (Rhizosphere Research Products) porewater samplers (n=3) were installed around Loblolly Pine (Pinus taeda) trees (n=8) one meter from the tree stem in a triangle formation. In the WC, replicate rhizons (n=8) were installed in a line next to other synoptic sampling infrastructure as there are no trees present in the WC. Rhizons were sampled monthly from roughly May-November in 2022 and 2023. A need was connected to the rhizon and then inserted into an evacuated exetainer to pull sample from the ground, the samplers were porous from 5-15cm deep. After collection in the exetainers, the three replicate samples from one tree were combined and aliquoted into vials to measure porewater ion, sulfide, iron, and nutrient concentrations. Only samples from the GWI TR were able to be collected, the other plot shallow soils were too dry or well drained"
#write to a text file
writeLines(datadescription, "Data package/SynopticCB_Redox_ESSDIVE_DataDescription.txt")
