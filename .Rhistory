"Swamp" = "darkgrey",
"Wetland" = "#419973",
"Surface Water" = "#25ABE6"
), labels = c("Upland", "Swamp", "Transition", "Wetland", "Surface Water")) +
theme_classic() +
labs(x = " ", y = "DIC (mg/L)", title = "Synoptic CB Porewater: DIC") +
theme(
