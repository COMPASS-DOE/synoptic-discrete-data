TGAS_avg <- live_dat %>%
group_by(Month, Site, Zone) %>%
dplyr::summarize(mean_CH4 = mean(CH4_ppm, na.rm=TRUE),
sd_CH4 = sd(CH4_ppm, na.rm=TRUE),
mean_CO2 = mean(CO2_ppm, na.rm=TRUE),
sd_CO2 = sd(CO2_ppm, na.rm=TRUE))
plot1 <- ggplot(data=TGAS_avg, aes(x=Zone, y=mean_CH4, fill=Zone))+
geom_boxplot()+
facet_wrap( ~ Site, scales="free")+
scale_fill_manual(values=c("UP" = "#20063B","TR" = "#FFBC42"))+
labs(y="CH4 (ppm)")+
theme_bw()
print(plot1)
ggsave("Tree_GHG_SummaryPlot.png", plot = plot1)
plot2 <- ggplot(data=all_dat, aes(x=Sapflux_ID, y=CH4_ppm, fill=Sapflux_ID))+
